{
    "version": 3,
    "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Default (Release)",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "SUB0MEMPAGE_BUILD_TESTING": "ON",
                "SUB0MEMPAGE_BUILD_EXAMPLES": "OFF"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "binaryDir": "${sourceDir}/build-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "SUB0MEMPAGE_BUILD_TESTING": "ON",
                "SUB0MEMPAGE_BUILD_EXAMPLES": "OFF"
            }
        },
        {
            "name": "ci-msvc",
            "displayName": "CI - MSVC",
            "binaryDir": "${sourceDir}/build-ci",
            "cacheVariables": {
                "SUB0MEMPAGE_BUILD_TESTING": "ON",
                "SUB0MEMPAGE_BUILD_EXAMPLES": "OFF"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "ci-asan",
            "displayName": "CI - ASan/UBSan",
            "binaryDir": "${sourceDir}/build-asan",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
                "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
                "SUB0MEMPAGE_BUILD_TESTING": "ON",
                "SUB0MEMPAGE_BUILD_EXAMPLES": "OFF"
            },
            "condition": {
                "type": "notEquals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "ci-tsan",
            "displayName": "CI - TSan",
            "binaryDir": "${sourceDir}/build-tsan",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
                "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread",
                "SUB0MEMPAGE_BUILD_TESTING": "ON",
                "SUB0MEMPAGE_BUILD_EXAMPLES": "OFF"
            },
            "condition": {
                "type": "notEquals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "ci-msvc-asan",
            "displayName": "CI - MSVC ASan",
            "binaryDir": "${sourceDir}/build-msvc-asan",
            "cacheVariables": {
                "CMAKE_CXX_FLAGS": "/DWIN32 /D_WINDOWS /GR /EHsc /fsanitize=address /Zi",
                "CMAKE_EXE_LINKER_FLAGS": "/DEBUG",
                "SUB0MEMPAGE_BUILD_TESTING": "ON",
                "SUB0MEMPAGE_BUILD_EXAMPLES": "OFF"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "ci-unix",
            "displayName": "CI - GCC/Clang",
            "binaryDir": "${sourceDir}/build-ci",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "SUB0MEMPAGE_BUILD_TESTING": "ON",
                "SUB0MEMPAGE_BUILD_EXAMPLES": "OFF"
            },
            "condition": {
                "type": "notEquals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default",
            "configuration": "Release"
        },
        {
            "name": "debug",
            "configurePreset": "debug",
            "configuration": "Debug"
        },
        {
            "name": "ci-msvc",
            "configurePreset": "ci-msvc",
            "configuration": "Release"
        },
        {
            "name": "ci-unix",
            "configurePreset": "ci-unix"
        },
        {
            "name": "ci-asan",
            "configurePreset": "ci-asan"
        },
        {
            "name": "ci-tsan",
            "configurePreset": "ci-tsan"
        },
        {
            "name": "ci-msvc-asan",
            "configurePreset": "ci-msvc-asan",
            "configuration": "Release"
        }
    ],
    "testPresets": [
        {
            "name": "default",
            "configurePreset": "default",
            "configuration": "Release",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "debug",
            "configurePreset": "debug",
            "configuration": "Debug",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "ci-msvc",
            "configurePreset": "ci-msvc",
            "configuration": "Release",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "ci-unix",
            "configurePreset": "ci-unix",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "ci-asan",
            "configurePreset": "ci-asan",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "ci-tsan",
            "configurePreset": "ci-tsan",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "ci-msvc-asan",
            "configurePreset": "ci-msvc-asan",
            "configuration": "Release",
            "output": { "outputOnFailure": true }
        }
    ]
}
